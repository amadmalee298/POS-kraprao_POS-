# ANTHROPIC_API_KEY: Claude API key used by every AI feature (receipt scanner, menu
# engineering, inventory forecast, waste analysis, POS upsell). Without it those features
# fall back to their built-in rule-based engines (the receipt scanner needs a key).
ANTHROPIC_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Extra origins (comma-separated) allowed to call this server's /api routes,
# e.g. the GitHub Pages site: https://<user>.github.io
# Requests from the server's own origin are always allowed.
ALLOWED_ORIGINS=""

# VITE_API_BASE_URL (build time, frontend): URL of the deployed server.ts backend when the
# frontend is hosted elsewhere (GitHub Pages). Leave empty when server.ts serves the frontend.
VITE_API_BASE_URL=""
